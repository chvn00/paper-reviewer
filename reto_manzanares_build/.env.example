ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=false

DATABASE_PATH=data/manzanares.db
COMPANY_NAME=Grupo Manzanares S.A.S.
MONTHLY_SALES_BASELINE_COP=40000000
MONTHLY_SALES_TARGET_COP=80000000

# La operacion deterministica es el valor seguro para el piloto.
LLM_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RESPONSE_CHARS=6000

# La API escucha solo en localhost. Para usar 0.0.0.0 se exige API_TOKEN.
API_HOST=127.0.0.1
API_PORT=8080
API_TOKEN=
REQUEST_MAX_BYTES=65536

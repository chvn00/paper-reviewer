# ── Required ─────────────────────────────────────────────────────────────────
# Groq API key — get it free at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Access token — share this with your team (they paste it on first login)
# Can be any random string, e.g.: openssl rand -hex 16
ACCESS_TOKEN=change_me_random_secret_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Groq model (default: llama-3.3-70b-versatile)
# Options: llama-3.3-70b-versatile | llama-3.1-70b-versatile | mixtral-8x7b-32768 | llama-3.1-8b-instant
# GROQ_MODEL=llama-3.3-70b-versatile
